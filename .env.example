APP_NAME=GearNest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gearnest
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache: "file" for local without Redis; "redis" in Docker (see docker-compose.yml).
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Redis (predis = pure-PHP client, no extension needed).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Idle session timeout (minutes): tokens unused this long are auto-logged out.
SANCTUM_IDLE_TIMEOUT=30

# Midtrans Configuration.
# Leave the TESTKEY placeholders to run offline: PaymentService then skips the
# real Snap call (and the webhook signature check) instead of failing.
# Fill in real keys from dashboard.midtrans.com > Settings > Access Keys.
# IS_PRODUCTION=true charges REAL money — keep false for sandbox.
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=SB-Mid-server-TESTKEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-TESTKEY
MIDTRANS_IS_PRODUCTION=false

# GearNest Delivery Parameters
DELIVERY_BASE_FEE=10000
DELIVERY_PER_KM_FEE=3000
DELIVERY_MAX_DISTANCE_KM=50
LOW_STOCK_THRESHOLD=3
