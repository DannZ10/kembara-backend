          "request": {
            "method": "PATCH",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"returned\"\n}" },
            "url": { "raw": "{{base_url}}/admin/bookings/{{booking_id}}/status", "host": [ "{{base_url}}" ], "path": [ "admin", "bookings", "{{booking_id}}", "status" ] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('status returned', () => pm.expect(String(j.data.status)).to.include('returned'));",
              "pm.test('returned_at stamped', () => pm.expect(j.data.returned_at).to.not.be.null);"
            ] } }
          ]
        },
        {
          "name": "PATCH /admin/bookings/{id}/verify (identity guarantee)",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"verified\": true\n}" },
            "url": { "raw": "{{base_url}}/admin/bookings/{{booking_id}}/verify", "host": [ "{{base_url}}" ], "path": [ "admin", "bookings", "{{booking_id}}", "verify" ] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('identity_verified true', () => pm.expect(pm.response.json().data.identity_verified).to.be.true);"
            ] } }
          ]
        },
        {
          "name": "PATCH /admin/bookings/{id}/identity-returned",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"returned\": true\n}" },
            "url": { "raw": "{{base_url}}/admin/bookings/{{booking_id}}/identity-returned", "host": [ "{{base_url}}" ], "path": [ "admin", "bookings", "{{booking_id}}", "identity-returned" ] }
