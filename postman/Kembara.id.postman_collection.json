    {
      "name": "5. Security / AuthZ (negative)",
      "item": [
        {
          "name": "GET /profile without token -> 401",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/profile", "host": [ "{{base_url}}" ], "path": [ "profile" ] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('unauthenticated rejected (401)', () => pm.response.to.have.status(401));"
            ] } }
          ]
        },
        {
          "name": "GET /admin/bookings as customer -> 403",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{customer_token}}" } ],
            "url": { "raw": "{{base_url}}/admin/bookings", "host": [ "{{base_url}}" ], "path": [ "admin", "bookings" ] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('customer blocked from admin (403)', () => pm.response.to.have.status(403));"
            ] } }
          ]
        },
        {
          "name": "GET /auth/google/redirect -> 302",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/auth/google/redirect", "host": [ "{{base_url}}" ], "path": [ "auth", "google", "redirect" ] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "// Run Newman with --ignore-redirects so the 302 is asserted instead of followed.",
              "pm.test('OAuth entrypoint redirects (302)', () => pm.expect([301, 302]).to.include(pm.response.code));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "6. Logout",
      "item": [
        {
          "name": "POST /logout (customer)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{customer_token}}" } ],
            "url": { "raw": "{{base_url}}/logout", "host": [ "{{base_url}}" ], "path": [ "logout" ] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('success true', () => pm.expect(pm.response.json().success).to.be.true);"
            ] } }
          ]
        }
      ]
    }
  ]
}
